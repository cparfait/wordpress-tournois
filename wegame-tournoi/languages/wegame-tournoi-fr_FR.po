msgstr "à"

#: includes/class-wgt-admin.php:531
#: includes/class-wgt-tournament.php:414
msgid "The tournament name is required."
msgstr "Le nom du tournoi est obligatoire."

#: includes/class-wgt-admin.php:545
msgid "Danger zone: reset or delete the tournament"
msgstr "Zone sensible : réinitialiser ou supprimer le tournoi"

